// SPDX-License-Identifier: (GPL-2.0-or-later OR MIT)
/*
 * Unified OpenWrt 25.12 DTS for Cudy TR3600 v1 (MT7987B + MT7990 Wi-Fi 7)
 * Combines:
 *  - OpenWrt PR #24596 (512 MiB memory, fan_3p3v GPIO6 regulator, &eth, partitions)
 *  - OpenWrt PR #25860 (PWM0 fan channel, red/white LEDs, MAC layout)
 *  - OpenWrt PR #25996 (RTL8221B WAN PHY eee-broken-100tx/1000t fix for 6.12)
 *  - Community verified tuning (68/78/88C silent fan curve, pci=noaer, USB2 stability)
 */

/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

#include "mt7987b.dtsi"

/ {
	model = "Cudy TR3600 v1";
	compatible = "cudy,tr3600-v1", "mediatek,mt7987b", "mediatek,mt7987";

	aliases {
		serial0 = &uart0;
		label-mac-device = &gmac1;
		led-boot = &led_sys_red;
		led-failsafe = &led_sys_red;
		led-running = &led_sys_white;
		led-upgrade = &led_sys_white;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs = "console=ttyS0,115200n1 earlycon=uart8250,mmio32,0x11000000 pci=pcie_bus_perf pci=noaer";
	};

	/* Cudy TR3600 v1 has 512 MiB DDR4 at 0x40000000 */
	memory {
		device_type = "memory";
		reg = <0 0x40000000 0 0x20000000>;
	};

	gpio-keys {
		compatible = "gpio-keys";

		button-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pio 1 GPIO_ACTIVE_LOW>;
			debounce-interval = <10>;
		};

		button-mode {
			label = "mode";
			linux,code = <BTN_0>;
			linux,input-type = <EV_SW>;
			gpios = <&pio 0 GPIO_ACTIVE_LOW>;
			debounce-interval = <10>;
		};
	};

	gpio-leds {
		compatible = "gpio-leds";

		led_sys_red: led-0 {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_RED>;
			gpios = <&pio 46 GPIO_ACTIVE_LOW>;
		};

		led_sys_white: led-1 {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_WHITE>;
			gpios = <&pio 48 GPIO_ACTIVE_LOW>;
		};
	};

	fan_3p3v: regulator-fan-3p3v {
		compatible = "regulator-fixed";
		enable-active-high;
		gpios = <&pio 6 GPIO_ACTIVE_HIGH>;
		regulator-name = "fan";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};
};

&eth {
	status = "okay";
};

&fan {
	fan-supply = <&fan_3p3v>;
	pwms = <&pwm 0 50000 0>;
	cooling-levels = <0 128 200 255>;
	status = "okay";
};

&cpu_thermal {
	trips {
		cpu_trip_active_low: active-low {
			temperature = <68000>;
			hysteresis = <5000>;
		};

		cpu_trip_active_med: active-med {
			temperature = <78000>;
			hysteresis = <5000>;
		};

		cpu_trip_active_high: active-high {
			temperature = <88000>;
			hysteresis = <5000>;
		};
	};
};

&gmac0 {
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&macaddr_bdinfo_de00 1>;
	phy-mode = "2500base-x";
	phy-handle = <&phy1>;
	status = "okay";
};

&gmac1 {
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&macaddr_bdinfo_de00 0>;
	phy-mode = "internal";
	phy-handle = <&phy15>;
	status = "okay";
};

&mdio {
	phy1: phy@1 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <1>;
		reset-assert-us = <100000>;
		reset-deassert-us = <100000>;
		reset-gpios = <&pio 42 GPIO_ACTIVE_LOW>;
		interrupts = <41 IRQ_TYPE_LEVEL_LOW>;
		interrupt-parent = <&pio>;
		/* PR #25996: fixes ~41% packet loss on 1G/100M WAN links */
		eee-broken-100tx;
		eee-broken-1000t;
	};

	phy15: phy@15 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <15>;
	};
};

&pcie0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie0_pins>;
	status = "okay";

	pcie@0,0 {
		reg = <0x0000 0 0 0 0>;
		device_type = "pci";
		#address-cells = <3>;
		#size-cells = <2>;

		wifi@0,0 {
			compatible = "mediatek,mt76";
			reg = <0x0000 0 0 0 0>;

			nvmem-cells = <&eeprom_factory_0>;
			nvmem-cell-names = "eeprom";

			#address-cells = <1>;
			#size-cells = <0>;

			band@0 {
				reg = <0>;
				nvmem-cells = <&macaddr_bdinfo_de00 0>;
				nvmem-cell-names = "mac-address";
			};

			band@1 {
				reg = <1>;
				nvmem-cells = <&macaddr_bdinfo_de00 2>;
				nvmem-cell-names = "mac-address";
			};
		};
	};
};

&pwm {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm_pins>;
	status = "okay";
};

&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_flash_pins>;
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;

		spi-max-frequency = <52000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;

		mediatek,nmbm;
		mediatek,bmt-max-ratio = <1>;
		mediatek,bmt-max-reserved-blocks = <64>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "BL2";
				reg = <0x000000 0x0100000>;
				read-only;
			};

			partition@100000 {
				label = "backup";
				reg = <0x100000 0x0080000>;
			};

			partition@180000 {
				label = "Factory";
				reg = <0x180000 0x0400000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom_factory_0: eeprom@0 {
						reg = <0x0 0x1e00>;
					};
				};
			};

			partition@580000 {
				label = "bdinfo";
				reg = <0x580000 0x0040000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_bdinfo_de00: macaddr@de00 {
						compatible = "mac-base";
						reg = <0xde00 0x6>;
						#nvmem-cell-cells = <1>;
					};
				};
			};

			partition@5c0000 {
				label = "FIP";
				reg = <0x5c0000 0x0200000>;
				read-only;
			};

			partition@7c0000 {
				label = "ubi";
				reg = <0x7c0000 0xe840000>;
				compatible = "linux,ubi";
			};
		};
	};
};

&ssusb {
	status = "okay";
	mediatek,u3p-dis-msk = <0x1>;
};

&tphyu2port0 {
	status = "okay";
};

&tphyu3port0 {
	status = "disabled";
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pins>;
	status = "okay";
};
