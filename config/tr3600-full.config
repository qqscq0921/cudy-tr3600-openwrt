# Full image: Cudy TR3600 v1 (MediaTek MT7987B + MT7990 Wi-Fi 7)
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_cudy_tr3600-v1=y
CONFIG_CCACHE=y

# Web UI (LuCI + HTTPS + Chinese + Terminal)
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-app-tr3600-fan=y

# Proxy Engine + GUI: Nikki (mihomo-meta + Metacubexd/Yacd dashboard + nftables native)
CONFIG_PACKAGE_mihomo-meta=y
CONFIG_PACKAGE_nikki=y
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y
CONFIG_PACKAGE_luci-app-openclash=m

# Mesh VPN: Tailscale daemon and its LuCI management page
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_luci-app-tailscale-community=y

# Optional extensions: compile as .ipk for the matching package repository, not into the image.
CONFIG_PACKAGE_kmod-wireguard=m
CONFIG_PACKAGE_wireguard-tools=m
CONFIG_PACKAGE_luci-proto-wireguard=m
CONFIG_PACKAGE_kmod-sched-cake=m
CONFIG_PACKAGE_kmod-ifb=m
CONFIG_PACKAGE_sqm-scripts=m
CONFIG_PACKAGE_luci-app-sqm=m
CONFIG_PACKAGE_kmod-usb-storage=m
CONFIG_PACKAGE_kmod-usb-storage-uas=m
CONFIG_PACKAGE_kmod-fs-ext4=m
CONFIG_PACKAGE_kmod-fs-exfat=m
CONFIG_PACKAGE_kmod-fs-ntfs3=m
CONFIG_PACKAGE_block-mount=m
CONFIG_PACKAGE_luci-app-mount=m
CONFIG_PACKAGE_samba4-server=m
CONFIG_PACKAGE_luci-app-samba4=m
CONFIG_PACKAGE_kmod-usb-serial=m
CONFIG_PACKAGE_kmod-usb-serial-option=m
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=m
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=m
CONFIG_PACKAGE_uqmi=m
CONFIG_PACKAGE_umbim=m
CONFIG_PACKAGE_luci-proto-qmi=m
CONFIG_PACKAGE_luci-proto-mbim=m

# Optional device management and network services
CONFIG_PACKAGE_luci-app-statistics=m
CONFIG_PACKAGE_collectd=m
CONFIG_PACKAGE_luci-app-wol=m
CONFIG_PACKAGE_etherwake=m
CONFIG_PACKAGE_luci-app-ddns=m
CONFIG_PACKAGE_ddns-scripts=m
CONFIG_PACKAGE_luci-app-watchcat=m
CONFIG_PACKAGE_watchcat=m
CONFIG_PACKAGE_luci-app-upnp=m
CONFIG_PACKAGE_miniupnpd=m
CONFIG_PACKAGE_luci-app-mwan3=m
CONFIG_PACKAGE_mwan3=m
CONFIG_PACKAGE_nlbwmon=m
CONFIG_PACKAGE_luci-app-nlbwmon=m
CONFIG_PACKAGE_nft-qos=m
CONFIG_PACKAGE_luci-app-nft-qos=m

# Transparent proxy & Kill Switch kernel prerequisites
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ca-bundle=y

# Network performance & diagnostics
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-sched=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_lm-sensors=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_nano=y

# USB Ethernet adapters: Realtek, ASIX, Aquantia, Microchip, SMSC, CDC, and RNDIS
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-aqc111=y
CONFIG_PACKAGE_kmod-usb-net-lan78xx=y
CONFIG_PACKAGE_kmod-usb-net-smsc75xx=y
CONFIG_PACKAGE_kmod-usb-net-smsc95xx=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
