		'unified-delay: true',
		'tcp-concurrent: false',
		'find-process-mode: off',
		'geo-auto-update: true',
		'geo-update-interval: 24',
		'external-controller: 0.0.0.0:9090',
		'external-ui: ui',
		'secret: ' + sprintf('%J', secret),
		'profile:',
		'  store-selected: true',
		'  store-fake-ip: true',
		'',
		'sniffer:',
		'  enable: true',
		'  force-dns-mapping: true',
		'  parse-pure-ip: true',
		'  sniff:',
		'    HTTP:',
		'      ports: [80, 8080-8880]',
		'      override-destination: true',
		'    TLS:',
		'      ports: [443, 8443]',
		'    QUIC:',
		'      ports: [443, 8443]',
		'',
		'dns:',
		'  enable: true',
		'  listen: 0.0.0.0:1053',
		'  ipv6: false',
		'  enhanced-mode: fake-ip',
		'  fake-ip-range: 198.18.0.1/16',
		'  fake-ip-filter:',
		"    - '+.lan'",
		"    - '+.local'",
		"    - 'time.*.com'",
		"    - 'ntp.*.com'",
		"    - '+.msftconnecttest.com'",
		"    - '+.msftncsi.com'",
		"    - 'seetacloud.com'",
		"    - '+.seetacloud.com'",
		"    - 'autodl.com'",
		"    - '+.autodl.com'",
		'  default-nameserver:',
		'    - 223.5.5.5',
		'    - 223.6.6.6',
		'  proxy-server-nameserver:',
		'    - https://223.5.5.5/dns-query',
		'    - https://223.6.6.6/dns-query',
		'  direct-nameserver:',
		'    - https://223.5.5.5/dns-query',
		'    - https://223.6.6.6/dns-query',
		'  nameserver:',
		"    - 'https://1.1.1.1/dns-query#🚀 日常代理'",
		"    - 'https://8.8.8.8/dns-query#🚀 日常代理'",
		'  nameserver-policy:',
		"    'geosite:cn,private':",
		'      - https://223.5.5.5/dns-query',
		'      - https://223.6.6.6/dns-query',
		"    'geosite:anthropic,openai,google-gemini,xai,category-ai-!cn':",
		"      - 'https://1.1.1.1/dns-query#🤖 Claude-AI'",
		"      - 'https://8.8.8.8/dns-query#🤖 Claude-AI'",
		'',
		'proxies:',
	];
	for (let p in all_proxies) push(out, '  - ' + sprintf('%J', p));
	push(out, '', 'proxy-groups:');
	for (let g in groups) push(out, '  - ' + sprintf('%J', g));
	if (length(keys(providers)) > 0) {
		push(out, '', 'rule-providers:');
		for (let k, v in providers) push(out, '  ' + k + ': ' + sprintf('%J', v));
	}
	push(out, '', 'rules:');
	for (let r in rules) push(out, '  - ' + sprintf('%J', r));

	fs.writefile(PROFILE_TMP, join('\n', out) + '\n');

	// Validate strictly with mihomo -t before replacing live config
	let chk = run_cmd('mihomo -d /etc/nikki/run -t -f ' + sh_quote(PROFILE_TMP));
	if (chk.code != 0) {
		fs.unlink(PROFILE_TMP);
		return { ok: false, error: 'Mihomo 配置校验失败，未应用更改：\n' + chk.out };
	}

	// Backup old profile & atomic replace
	if (fs.stat(PROFILE_PATH)) {
		run_cmd('cp ' + sh_quote(PROFILE_PATH) + ' ' + sh_quote(PROFILE_PATH + '.bak'));
	}
	fs.rename(PROFILE_TMP, PROFILE_PATH);
	fs.chmod(PROFILE_PATH, 0600);
	save_studio(studio);

	// Zero-downtime hot-reload via Mihomo API if running, else fallback to nikki restart
	let pid = trim(run_cmd('pidof mihomo').out);
	if (length(pid) > 0) {
		run_cmd('cp ' + sh_quote(PROFILE_PATH) + ' /etc/nikki/run/config.yaml && chmod 600 /etc/nikki/run/config.yaml');
		let hr = mihomo_req('PUT', '/configs?force=true', { path: '/etc/nikki/run/config.yaml' });
		if (hr.code == 0 && length(trim(hr.out)) == 0) {
			return { ok: true, proxy_count: length(all_proxies), reload_mode: 'hot' };
		}
	}
	let rel = run_cmd('/etc/init.d/nikki restart');
	return { ok: rel.code == 0, proxy_count: length(all_proxies), reload_mode: 'restart', reload_out: trim(rel.out) };
}

function fetch_subscription(sub) {
	fs.mkdir(SUBS_DIR, 0700);
	let raw_file = '/tmp/sub_fetch_' + sub.id + '.raw';
	let proxy_flag = sub.use_proxy ? '-x http://127.0.0.1:7890' : '';
	let cmd = 'curl -sSL -m 25 ' + proxy_flag + ' -A "ClashMeta" -w "\\n__HTTP_CODE__%{http_code}" ' + sh_quote(sub.url) + ' -o ' + sh_quote(raw_file);
	let r = run_cmd(cmd);
	let m = match(r.out, /__HTTP_CODE__(\d+)/);
	let code = m ? int(m[1]) : 0;
	if (r.code != 0 || code < 200 || code >= 300) {
		fs.unlink(raw_file);
		return { ok: false, error: '拉取订阅失败 (HTTP ' + code + '): ' + trim(r.out) };
	}
	// Parse Clash YAML proxies via yq -> JSON
	let yq_r = run_cmd('yq -o=json ".proxies // []" ' + sh_quote(raw_file));
	let parsed = null;
	if (yq_r.code == 0) {
		try {
			let j = json(yq_r.out);
			if (type(j) == 'array' && length(j) > 0) parsed = j;
		} catch (e) {}
	}
	// Fallback: Base64 list of vless:// / ss:// URIs
	if (!parsed) {
		let txt = fs.readfile(raw_file) ?? '';
		let dec = b64dec(replace(txt, /\s+/g, '')) ?? txt;
		let nodes = [];
		for (let ln in split(dec, /\r?\n/)) {
			ln = trim(ln);
			if (index(ln, 'vless://') == 0) {
				let n = parse_vless_uri(ln, null);
				if (n) push(nodes, n);
			} else if (index(ln, 'ss://') == 0) {
				let n = parse_ss_uri(ln, null);
				if (n) push(nodes, n);
			}
		}
		if (length(nodes) > 0) parsed = nodes;
	}
	fs.unlink(raw_file);
	if (!parsed || length(parsed) == 0) {
		return { ok: false, error: '订阅内容未解析出有效 Clash/VLESS/SS 节点（请确认链接返回 Clash 格式）' };
	}
	let cpath = SUBS_DIR + '/' + sub.id + '.json';
	fs.writefile(cpath + '.tmp', sprintf('%J\n', parsed));
	fs.rename(cpath + '.tmp', cpath);
	sub.node_count = length(parsed);
	let dt = run_cmd('date "+%Y-%m-%d %H:%M"');
	sub.updated_at = trim(dt.out);
	return { ok: true, count: length(parsed) };
}

// --- Main CGI Handler ---
let q = parse_query(getenv('QUERY_STRING'));
let action = q.action || 'state';
let expected = get_secret();
if (!expected) {
	send_json({ ok: false, error: 'nikki.mixin.api_secret 未配置' }, 500);
}
let auth_hdr = getenv('HTTP_AUTHORIZATION') || '';
let bearer = match(auth_hdr, /^Bearer\s+(.+)$/i);
let token = (bearer ? trim(bearer[1]) : '') || getenv('HTTP_X_PROXY_TOKEN') || q.token || '';

if (action == 'auth_check') {
	send_json({ ok: token == expected });
}
if (token != expected) {
	send_json({ ok: false, auth_error: true, error: '密钥错误，请重新输入管理密码' }, 401);
}

if (action == 'state') {
	let studio = load_studio();
	let temp_raw = trim(fs.readfile('/sys/class/thermal/thermal_zone0/temp') ?? '0');
	let temp_c = int(temp_raw) / 1000.0;
	let mem = run_cmd('free -m | awk "/Mem:/ {print \\$2,\\$3,\\$7}"');
	let mp = split(trim(mem.out), /\s+/);
	let pid = trim(run_cmd('pidof mihomo').out);
	let ks = run_cmd('nft list chain inet fw4 forward_lan 2>/dev/null');
	let killswitch = index(ks.out, 'accept_to_wan') < 0 && length(ks.out) > 0;

	let live_proxies = {};
	let live_providers = {};
	if (length(pid) > 0) {
		let pr = mihomo_req('GET', '/proxies', null);
		if (pr.code == 0) {
			try {
				let pj = json(pr.out);
				live_proxies = pj.proxies ?? {};
			} catch (e) {}
		}
		let rp = mihomo_req('GET', '/providers/rules', null);
		if (rp.code == 0) {
			try {
				let rj = json(rp.out);
				live_providers = rj.providers ?? {};
			} catch (e) {}
		}
	}
	let claude_sync = null;
	let cs_raw = fs.readfile(CLAUDE_SYNC_STATUS);
	if (cs_raw) { try { claude_sync = json(cs_raw); } catch (e) {} }
	send_json({
		ok: true,
		system: {
			temp_c: temp_c,
			mem_total_kb: int(mp[0] ?? 0),
			mem_used_kb: int(mp[1] ?? 0),
			mem_avail_kb: int(mp[2] ?? 0),
			mihomo_running: length(pid) > 0,
			killswitch_active: killswitch,
		},
		studio: studio,
		live_proxies: live_proxies,
		live_providers: live_providers,
		claude_sync: claude_sync,
		builtin_rules: get_builtin_rules_meta(),
	});
}

if (action == 'switch') {
	let body = read_body_json();
	let r = mihomo_req('PUT', '/proxies/' + url_encode(body.group || ''), { name: body.name || '' });
	send_json({ ok: r.code == 0 && length(trim(r.out)) == 0, out: r.out });
}

if (action == 'test_delay') {
	let body = read_body_json();
	let enc = url_encode(body.name || '');
	let path = body.is_group
		? ('/group/' + enc + '/delay?timeout=6000&url=https://www.gstatic.com/generate_204')
		: ('/proxies/' + enc + '/delay?timeout=6000&url=https://www.gstatic.com/generate_204');
	let r = mihomo_req('GET', path, null);
	let parsed = null;
	try { parsed = json(r.out); } catch (e) { parsed = { message: r.out }; }
	send_json({ ok: true, data: parsed });
}

if (action == 'sub_save') {
	let body = read_body_json();
	let studio = load_studio();
	if (body.delete_id) {
		studio.subscriptions = filter(studio.subscriptions, (x) => x.id != body.delete_id);
		fs.unlink(SUBS_DIR + '/' + body.delete_id + '.json');
		let res = build_and_apply(studio);
		send_json(res);
	}
	let sub = null;
	for (let s in studio.subscriptions) {
		if (s.id == body.id) { sub = s; break; }
	}
	let is_new = !sub;
	if (is_new) {
		sub = {
			id: 'sub_' + time(),
			name: trim(body.name || '新机场订阅'),
			url: trim(body.url || ''),
			enabled: true,
			use_proxy: !!body.use_proxy,
			node_count: 0,
			updated_at: '',
		};
		push(studio.subscriptions, sub);
	} else {
		if (body.name != null) sub.name = trim(body.name);
		if (body.url != null) sub.url = trim(body.url);
		if (body.enabled != null) sub.enabled = !!body.enabled;
		if (body.use_proxy != null) sub.use_proxy = !!body.use_proxy;
	}
	if (body.fetch_now && length(sub.url) > 0) {
		let fr = fetch_subscription(sub);
		if (!fr.ok) send_json(fr);
	}
	let res = build_and_apply(studio);
	res.sub = sub;
	send_json(res);
}

if (action == 'sub_refresh') {
	let body = read_body_json();
	let studio = load_studio();
	let target = null;
	for (let s in studio.subscriptions) {
		if (s.id == body.id) { target = s; break; }
	}
	if (!target) send_json({ ok: false, error: '找不到该订阅' }, 404);
	if (!target.url || length(target.url) == 0) send_json({ ok: false, error: '该条是本地导入缓存，没有可刷新的 URL' }, 400);
	let fr = fetch_subscription(target);
	if (!fr.ok) send_json(fr);
	let res = build_and_apply(studio);
	res.fetched = fr.count;
	send_json(res);
}

if (action == 'node_save') {
	let body = read_body_json();
	let studio = load_studio();
	if (body.delete_id) {
		studio.custom_nodes = filter(studio.custom_nodes, (x) => x.id != body.delete_id);
		send_json(build_and_apply(studio));
	}
	let cfg = body.config;
	if (!cfg && body.uri) {
		let u = trim(body.uri);
		if (index(u, 'vless://') == 0) cfg = parse_vless_uri(u, body.name);
		else if (index(u, 'ss://') == 0) cfg = parse_ss_uri(u, body.name);
		else {
			try { cfg = json(u); } catch (e) {}
		}
	}
	if (!cfg || type(cfg) != 'object' || !cfg.name || !cfg.type) {
		send_json({ ok: false, error: '无法解析节点，请粘贴标准 vless:// 或 ss:// 链接（或合法 JSON 对象）' }, 400);
	}
	let item = null;
	for (let n in studio.custom_nodes) {
		if (n.id == body.id) { item = n; break; }
	}
	if (!item) {
		item = {
			id: 'node_' + time(),
			enabled: true,
			dialer_proxy: body.dialer_proxy ?? '',
			claude_exit: !!body.claude_exit,
			config: cfg,
		};
		push(studio.custom_nodes, item);
	} else {
		if (body.enabled != null) item.enabled = !!body.enabled;
		if (body.dialer_proxy != null) item.dialer_proxy = body.dialer_proxy;
		if (body.claude_exit != null) item.claude_exit = !!body.claude_exit;
		if (cfg) item.config = cfg;
	}
	send_json(build_and_apply(studio));
}

if (action == 'rule_save') {
	let body = read_body_json();
	let studio = load_studio();
	if (body.delete_id) {
		studio.custom_rules = filter(studio.custom_rules, (x) => x.id != body.delete_id);
		send_json(build_and_apply(studio));
	}
	let item = null;
	for (let r in studio.custom_rules) {
		if (r.id == body.id) { item = r; break; }
	}
	if (!item) {
		let rtype = body.type || 'DOMAIN-SUFFIX';
		let rval = trim(body.value || '');
		let gm = match(rval, /^(geosite|geoip):(.+)$/i);
		if (gm) {
			rtype = uc(gm[1]);
			rval = trim(gm[2]);
		}
		item = {
			id: 'rule_' + time(),
			type: rtype,
			value: rval,
			target: body.target || '🤖 Claude-AI',
			note: trim(body.note || ''),
			enabled: true,
		};
		if (length(item.value) == 0) send_json({ ok: false, error: '匹配值不能为空' }, 400);
		unshift(studio.custom_rules, item);
	} else {
		if (body.enabled != null) item.enabled = !!body.enabled;
		if (body.type != null) item.type = body.type;
		if (body.value != null) item.value = trim(body.value);
		if (body.target != null) item.target = body.target;
		if (body.note != null) item.note = trim(body.note);
	}
	send_json(build_and_apply(studio));
}

if (action == 'ruleset_save') {
	let body = read_body_json();
	let studio = load_studio();
	if (!studio.rule_sets) studio.rule_sets = [];
	if (body.delete_id) {
		studio.rule_sets = filter(studio.rule_sets, (x) => x.id != body.delete_id);
		send_json(build_and_apply(studio));
	}
	let item = null;
	for (let rs in studio.rule_sets) {
		if (rs.id == body.id) { item = rs; break; }
	}
	if (!item) {
		let url = trim(body.url || '');
		if (length(url) == 0) send_json({ ok: false, error: '规则集 URL 不能为空' }, 400);
		let raw_id = trim(body.id || ('rs_' + time()));
		let safe_id = replace(raw_id, /[^A-Za-z0-9_-]/g, '_');
		if (safe_id == 'claude_netcoffee' || safe_id == 'claude_bm7') safe_id += '_' + time();
		let fmt = body.format || (match(url, /\.mrs(\?|$)/i) ? 'mrs' : (match(url, /\.list(\?|$)/i) ? 'text' : 'yaml'));
		let beh = body.behavior || (fmt == 'mrs' ? 'domain' : 'classical');
		item = {
			id: safe_id,
			name: trim(body.name || safe_id),
			source: trim(body.source || 'Custom'),
			url: url,
			format: fmt,
			behavior: beh,
			target: body.target || '🚀 日常代理',
			enabled: true,
		};
		unshift(studio.rule_sets, item);
	} else {
		if (body.enabled != null) item.enabled = !!body.enabled;
		if (body.target != null) item.target = body.target;
		if (body.name != null) item.name = trim(body.name);
	}
	send_json(build_and_apply(studio));
}

if (action == 'sync_rulesets') {
	let cs_out = run_cmd('/usr/bin/sync-claude-rules');
	let cs = null;
	try { cs = json(cs_out.out); } catch (e) { cs = { ok: cs_out.code == 0, raw: trim(cs_out.out) }; }
	let updated = [];
	let rp = mihomo_req('GET', '/providers/rules', null);
	if (rp.code == 0) {
		try {
			let provs = json(rp.out).providers ?? {};
			for (let k, v in provs) {
				let ur = mihomo_req('PUT', '/providers/rules/' + url_encode(k), null);
				push(updated, { name: k, ok: ur.code == 0 });
			}
		} catch (e) {}
	}
	send_json({ ok: true, claude_sync: cs, providers_updated: updated });
}

if (action == 'rebuild') {
	send_json(build_and_apply(load_studio()));
}

if (action == 'nikki_ctrl') {
	let body = read_body_json();
	let cmd = body.cmd || 'restart';
	if (cmd != 'restart' && cmd != 'reload' && cmd != 'stop' && cmd != 'start') {
		send_json({ ok: false, error: 'Invalid cmd' }, 400);
	}
	let r = run_cmd('/etc/init.d/nikki ' + cmd);
	send_json({ ok: r.code == 0, out: trim(r.out) });
}

send_json({ ok: false, error: 'Unknown action: ' + action }, 400);
