		'GEOIP,CN,DIRECT',
		'MATCH,🚀 日常代理',
	];
	for (let b in builtin) push(rules, b);

	let out = [
		'mixed-port: 7890',
		'tproxy-port: 7892',
		'allow-lan: true',
		"bind-address: '*'",
		'mode: rule',
		'log-level: warning',
