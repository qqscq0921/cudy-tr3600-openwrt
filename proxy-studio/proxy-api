		if (cn.enabled === false) continue;
		if (cn.dialer_proxy == '🇸🇬 新加坡中转') cn.dialer_proxy = '🛡️ 前置中转';
		let p = {};
		for (let k, v in cn.config) p[k] = v;
		if (cn.dialer_proxy && length(cn.dialer_proxy) > 0) {
			p['dialer-proxy'] = cn.dialer_proxy;
		} else {
			delete p['dialer-proxy'];
		}
		if (!p.name || seen[p.name]) continue;
		seen[p.name] = true;
		push(all_proxies, p);
		if (cn.claude_exit) push(claude_names, p.name);
	}

	// 2. Enabled subscriptions cached proxies
	for (let sub in (studio.subscriptions ?? [])) {
		if (sub.enabled === false) continue;
		let cpath = SUBS_DIR + '/' + sub.id + '.json';
		let raw = fs.readfile(cpath);
		if (!raw) continue;
		let arr = null;
		try { arr = json(raw); } catch (e) { continue; }
		if (type(arr) != 'array') continue;
		for (let p in arr) {
			if (type(p) != 'object' || !p.name) continue;
			let nm = p.name;
			if (match(nm, /^(Expire|Traffic|剩余流量|套餐到期|官网)/i)) continue;
			if (seen[nm]) continue;
			seen[nm] = true;
			push(all_proxies, p);
			push(sub_all, nm);
			if (index(nm, '新加坡') >= 0 || match(nm, /\bSG\b|Singapore/i)) push(sg_names, nm);
			if (index(nm, '日本') >= 0 || match(nm, /\bJP\b|Japan/i)) {
				push(jp_all, nm);
				if (index(nm, '高级') >= 0 || index(nm, 'IEPL') >= 0 || index(nm, 'IPLC') >= 0) push(jp_hi, nm);
			}
			if (index(nm, '香港') >= 0 || match(nm, /\bHK\b|Hong\s*Kong/i)) push(hk_names, nm);
			if (index(nm, '美国') >= 0 || match(nm, /\bUS\b|United States|America/i)) push(us_names, nm);
