const CLAUDE_SYNC_STATUS = '/etc/nikki/claude-sync-status.json';
const MIHOMO_API = 'http://127.0.0.1:9090';

function sh_quote(s) {
	return "'" + replace(s ?? '', "'", "'\\''") + "'";
}

function run_cmd(cmd) {
	let p = fs.popen(cmd + ' 2>&1', 'r');
	if (!p) return { code: -1, out: 'popen failed' };
	let out = p.read('all') ?? '';
	let code = p.close();
	return { code: code ?? 0, out: out };
}

function get_secret() {
	let r = run_cmd('uci -q get nikki.mixin.api_secret');
	let s = trim(r.out);
	return length(s) > 0 ? s : null;
}

function url_decode(s) {
	if (!s) return '';
	let out = replace(s, '+', ' ');
	return replace(out, /%([0-9A-Fa-f]{2})/g, function(m, hex) {
		return chr(int(hex, 16));
	});
}

function url_encode(s) {
	let out = '';
	for (let i = 0; i < length(s); i++) {
		let b = ord(s, i);
		if ((b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 45 || b == 46 || b == 95 || b == 126) {
			out += chr(b);
		} else {
			out += sprintf('%%%02X', b);
		}
	}
	return out;
}

function parse_query(qs) {
	let res = {};
	if (!qs) return res;
	for (let part in split(qs, '&')) {
		let idx = index(part, '=');
		if (idx >= 0) {
			res[url_decode(substr(part, 0, idx))] = url_decode(substr(part, idx + 1));
		} else if (length(part) > 0) {
			res[url_decode(part)] = '1';
		}
	}
	return res;
}

function send_json(obj, status) {
	if (status && status != 200) {
		let msg = status == 401 ? 'Unauthorized' : (status == 400 ? 'Bad Request' : 'Error');
		printf('Status: %d %s\r\n', status, msg);
	}
	print('Content-Type: application/json; charset=utf-8\r\n');
	print('Cache-Control: no-store\r\n\r\n');
	print(sprintf('%J', obj));
	exit(0);
}

function read_body_json() {
	let raw = fs.stdin.read('all');
	if (!raw || length(trim(raw)) == 0) return {};
	try {
		return json(raw);
	} catch (e) {
		send_json({ ok: false, error: 'Invalid JSON body: ' + e }, 400);
	}
}

function load_studio() {
	let raw = fs.readfile(STUDIO_PATH);
	if (!raw) {
		return { subscriptions: [], custom_nodes: [], custom_rules: [], rule_sets: [] };
	}
	let j = json(raw);
	if (!j.rule_sets) j.rule_sets = [];
	return j;
}

function save_studio(data) {
	fs.mkdir(SUBS_DIR, 0700);
	let tmp = STUDIO_PATH + '.tmp';
	fs.writefile(tmp, sprintf('%J\n', data));
	fs.rename(tmp, STUDIO_PATH);
}

function mihomo_req(method, path, body_obj) {
	let secret = get_secret();
	let cmd = 'curl -sS -m 10 -X ' + sh_quote(method) +
		' -H ' + sh_quote('Authorization: Bearer ' + secret);
	if (body_obj != null) {
		cmd += ' -H "Content-Type: application/json" -d ' + sh_quote(sprintf('%J', body_obj));
	}
	cmd += ' ' + sh_quote(MIHOMO_API + path);
	return run_cmd(cmd);
}

function parse_vless_uri(uri, custom_name) {
	// vless://uuid@host:port?params#name
	let m = match(uri, /^vless:\/\/([^@]+)@(\[[^\]]+\]|[^:\/?#]+):(\d+)([^#]*)(?:#(.*))?$/);
	if (!m) return null;
	let uuid = m[1];
	let host = replace(m[2], /^\[|\]$/g, '');
	let port = int(m[3]);
	let qraw = m[4] ?? '';
	let qidx = index(qraw, '?');
	let q = qidx >= 0 ? parse_query(substr(qraw, qidx + 1)) : {};
	let name = (custom_name && length(trim(custom_name)) > 0) ? trim(custom_name) : (m[5] ? url_decode(m[5]) : ('VLESS-' + host));
	let node = {
		name: name,
		type: 'vless',
		server: host,
		port: port,
		uuid: uuid,
		network: q.type || 'tcp',
		udp: true,
	};
	if (q.flow) node.flow = q.flow;
	let sec = q.security || '';
	if (sec == 'tls' || sec == 'reality') {
		node.tls = true;
		if (q.sni) node.servername = q.sni;
		if (q.fp) node['client-fingerprint'] = q.fp;
	}
	if (sec == 'reality') {
		node['reality-opts'] = {
			'public-key': q.pbk || '',
			'short-id': q.sid || '',
		};
	}
	if (node.network == 'ws') {
		node['ws-opts'] = { path: q.path || '/' };
		if (q.host) node['ws-opts'].headers = { Host: q.host };
	} else if (node.network == 'grpc') {
		node['grpc-opts'] = { 'grpc-service-name': q.serviceName || '' };
	}
	return node;
}

function parse_ss_uri(uri, custom_name) {
	// ss://BASE64@host:port/?plugin=...#name or ss://BASE64#name
	let m = match(uri, /^ss:\/\/([^#]+)(?:#(.*))?$/);
	if (!m) return null;
	let body = m[1];
	let name = (custom_name && length(trim(custom_name)) > 0) ? trim(custom_name) : (m[2] ? url_decode(m[2]) : 'SS-Node');
	let q = {};
	let qidx = index(body, '?');
	if (qidx >= 0) {
		q = parse_query(substr(body, qidx + 1));
		body = substr(body, 0, qidx);
	}
	body = replace(body, /\/$/, '');
	let cipher = '', password = '', host = '', port = 0;
	let at = index(body, '@');
	if (at >= 0) {
		let userinfo = substr(body, 0, at);
		let hp = substr(body, at + 1);
		if (index(userinfo, ':') < 0) {
			userinfo = b64dec(userinfo) ?? userinfo;
		} else {
			userinfo = url_decode(userinfo);
		}
		let cidx = index(userinfo, ':');
		if (cidx < 0) return null;
		cipher = substr(userinfo, 0, cidx);
		password = substr(userinfo, cidx + 1);
		let hm = match(hp, /^(\[[^\]]+\]|[^:]+):(\d+)$/);
		if (!hm) return null;
		host = replace(hm[1], /^\[|\]$/g, '');
		port = int(hm[2]);
	} else {
		let dec = b64dec(body);
		if (!dec) return null;
		let dm = match(dec, /^([^:]+):(.+)@([^:]+):(\d+)$/);
		if (!dm) return null;
		cipher = dm[1]; password = dm[2]; host = dm[3]; port = int(dm[4]);
	}
	let node = {
		name: name,
		type: 'ss',
		server: host,
		port: port,
		cipher: cipher,
		password: password,
		udp: true,
	};
	if (q.plugin) {
		let parts = split(q.plugin, ';');
		let pname = parts[0];
		if (pname == 'obfs-local' || pname == 'simple-obfs') {
			node.plugin = 'obfs';
			let opts = {};
			for (let i = 1; i < length(parts); i++) {
				let kv = split(parts[i], '=');
				if (kv[0] == 'obfs') opts.mode = kv[1];
				if (kv[0] == 'obfs-host') opts.host = kv[1];
			}
			node['plugin-opts'] = opts;
		}
	}
	return node;
}

function prefetch_provider(id, url, fmt) {
	fs.mkdir('/etc/nikki/run/providers', 0755);
	fs.mkdir(RULE_PROV_DIR, 0755);
	let ext = fmt == 'mrs' ? 'mrs' : (fmt == 'text' ? 'list' : 'yaml');
	let fpath = RULE_PROV_DIR + '/' + id + '.' + ext;
	if (fs.stat(fpath) && fs.stat(fpath).size > 16) return { ok: true, path: fpath };
	let tmp = fpath + '.tmp';
	let r = run_cmd('curl -4 -sSL -m 20 -x http://127.0.0.1:7890 ' + sh_quote(url) + ' -o ' + sh_quote(tmp));
	if (r.code != 0 || !fs.stat(tmp) || fs.stat(tmp).size < 16) {
		r = run_cmd('curl -4 -sSL -m 20 ' + sh_quote(url) + ' -o ' + sh_quote(tmp));
	}
	if (r.code != 0 || !fs.stat(tmp) || fs.stat(tmp).size < 16) {
		fs.unlink(tmp);
		return { ok: false, error: '拉取规则集失败：' + url };
	}
	fs.rename(tmp, fpath);
	fs.chmod(fpath, 0644);
	return { ok: true, path: fpath };
}

